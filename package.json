{
  "name": "setu-platform",
  "version": "1.0.0",
  "description": "Setu: BRICS Citizen-to-Infrastructure Intelligence Platform (Digital Public Good)",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server/server.ts",
    "dev:all": "concurrently \"tsx src/server/server.ts\" \"vite\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "brics",
    "civic-tech",
    "infrastructure",
    "digital-public-good",
    "ai-prioritization"
  ],
  "author": "Setu Open Source Initiative",
  "license": "Apache-2.0",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^0.475.0",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
